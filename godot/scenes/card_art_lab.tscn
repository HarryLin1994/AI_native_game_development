[node name="CardStage" type="PanelContainer" parent="RootMargin/Content"]
custom_minimum_size = Vector2(640, 940)
layout_mode = 2
size_flags_horizontal = 4

[node name="CardFramePlaceholder" type="ColorRect" parent="RootMargin/Content/CardStage"]
layout_mode = 2
mouse_filter = 2
color = Color(0.122, 0.129, 0.153, 1)

[node name="Caption" type="Label" parent="RootMargin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "MCP-ready Godot project shell. Card frame assets will replace the placeholder."
horizontal_alignment = 1
autowrap_mode = 3
